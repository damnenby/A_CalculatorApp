<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.A_CalculatorApp" parent="Theme.AppCompat.DayNight.DarkActionBar">
    </style>

    <style name="Theme.A_CalculatorApp" parent="Base.Theme.A_CalculatorApp" />

    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Digit">
        <item name="android:background">@color/btn_digit_bg</item>
        <item name="android:textColor">@color/btn_digit_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:background">@color/btn_operator_bg</item>
        <item name="android:textColor">@color/btn_operator_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="android:background">@color/btn_equals_bg</item>
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Util">
        <item name="android:background">@color/btn_util_bg</item>
        <item name="android:textColor">@color/btn_util_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Clear">
        <item name="android:background">@color/btn_clear_bg</item>
        <item name="android:textColor">@color/btn_clear_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Scientific">
        <item name="android:background">@color/btn_sci_bg</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
